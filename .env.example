NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_PASSWORD=
NEXT_PUBLIC_SITE_URL=

R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
NEXT_PUBLIC_R2_PUBLIC_URL=

# Email (Resend). From address must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Etivio <support@etivio.co>"
# Optional: where replies go (e.g. your support inbox)
EMAIL_REPLY_TO=

# Protects /api/cron/* (abandoned-checkout reminders). Any long random string; the scheduler sends it as a Bearer token.
CRON_SECRET=

# Payments (Paystack). Use a test key (sk_test_...) locally.
PAYSTACK_SECRET_KEY=

# Owner/staff. Comma-separated owner emails (defaults to etivio.co@gmail.com).
ETIVIO_OWNER_EMAILS=
# Fallback inbox for the contact form when no support email is set in admin settings.
CONTACT_INBOX=

# Optional email extras
EMAIL_ASSET_URL=
# Used only by scripts/configure-auth-email.mjs
EMAIL_FROM_ADDRESS=
EMAIL_SENDER_NAME=

# Optional: Supabase management API token (admin > emails > templates)
SUPABASE_ACCESS_TOKEN=

# Optional: AI features (Cloudflare Workers AI) and AI writer web research (Firecrawl)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
FIRECRAWL_API_KEY=

# Optional: Cloudflare TURN for calls (WebRTC ICE servers)
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
